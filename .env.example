# ==============================================================================
# .env.example - Environment Variables Template
# Project: COVID-19 Big Data Analytics Platform
#
# HOW TO USE:
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
#   Fill in your real values below.
#   NEVER commit .env — it is already in .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Atlas (REQUIRED)
# How to get:
#   1. Go to https://cloud.mongodb.com
#   2. Your Cluster → Connect → Drivers → Python 3.6+
#   3. Copy the connection string and replace <password>
# ------------------------------------------------------------------------------
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/covid_analytics?retryWrites=true&w=majority
MONGODB_DATABASE=covid_analytics

# ------------------------------------------------------------------------------
# Hadoop HDFS (only needed when using Docker cluster)
# ------------------------------------------------------------------------------
HDFS_NAMENODE_URI=hdfs://master:9000
HDFS_RAW_PATH=/covid/raw
HDFS_PROCESSED_PATH=/covid/processed
HDFS_OUTPUT_PATH=/covid/output

# ------------------------------------------------------------------------------
# Apache Spark (only needed when using Docker cluster)
# ------------------------------------------------------------------------------
SPARK_MASTER=spark://spark-master:7077
SPARK_EXECUTOR_MEMORY=1g
SPARK_EXECUTOR_CORES=2

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
