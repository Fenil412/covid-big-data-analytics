# =============================================================================
# .env.example — Environment Variables Template (SAFE TO COMMIT)
# Project: COVID-19 Big Data Analytics Platform
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your MongoDB Atlas URI and other values in .env
#   3. Never commit .env — it's already in .gitignore
# =============================================================================

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from: Atlas → Cluster → Connect → Drivers → Python 3.6+
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/covid_analytics?retryWrites=true&w=majority
MONGODB_DATABASE=covid_analytics

# ── Hadoop / HDFS ─────────────────────────────────────────────────────────────
HDFS_NAMENODE_URI=hdfs://master:9000
HDFS_RAW_PATH=/covid/raw
HDFS_PROCESSED_PATH=/covid/processed
HDFS_OUTPUT_PATH=/covid/output

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_MASTER=spark://master:7077
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
