# ==============================================================================
# .env.example — Environment Variables Template
# Project: COVID-19 Big Data Analytics Platform
#
# SETUP:
#   1. Copy this file:  copy .env.example .env
#   2. Fill in your MongoDB Atlas URI below
#   3. NEVER commit .env (it's in .gitignore)
#
# GET YOUR ATLAS URI:
#   MongoDB Atlas → Your Cluster → Connect → Drivers → Python 3.6+
#   Replace <password> with your actual password
# ==============================================================================

# ── MongoDB Atlas (REQUIRED) ──────────────────────────────────────────────────
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/covid_analytics?retryWrites=true&w=majority
MONGODB_DATABASE=covid_analytics

# ── Hadoop HDFS (Docker cluster mode only) ────────────────────────────────────
HDFS_NAMENODE_URI=hdfs://master:9000
HDFS_INPUT_PATH=/covid/input
HDFS_RAW_PATH=/covid/input
HDFS_PROCESSED_PATH=/covid/processed
HDFS_OUTPUT_PATH=/covid/output

# ── Apache Spark (Docker cluster mode only) ───────────────────────────────────
# yarn = YARN on Hadoop cluster (default for run-analysis)
# cluster = Spark standalone spark://spark-master:7077
SPARK_RUN_MODE=yarn
SPARK_MASTER=spark://spark-master:7077
SPARK_EXECUTOR_INSTANCES=2
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
